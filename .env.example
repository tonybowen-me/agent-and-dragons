# Postgres connection string. Local dev example (see README for docker one-liner):
DATABASE_URL="postgresql://aad:devpass@localhost:5433/aad?schema=public"
# Optional: set to enable real LLM DM/agents. Without it the app uses a deterministic offline engine.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Secret used to sign session cookies
SESSION_SECRET=""
# Optional: only needed for the MCP server on serverless/multi-instance hosts,
# so Streamable HTTP session state persists across instances. Not needed for a
# single long-running Node process.
REDIS_URL=""
